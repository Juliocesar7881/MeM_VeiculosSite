# ---------------------------------------------------------------------------
# M&M Veículos — variáveis de ambiente
# Copie para `.env` em desenvolvimento. Em produção configure no painel da Vercel.
# NUNCA versione valores reais de segredos.
# ---------------------------------------------------------------------------

# URL pública do site. Pode ficar vazia em desenvolvimento/preview (usa a URL da requisição).
# Preencha somente quando o domínio definitivo existir, ex.: https://www.mmveiculos.com.br
PUBLIC_SITE_URL=

# Permite indexação por buscadores (robots.txt/X-Robots-Tag). Deixe false até publicar
# no domínio definitivo, para o Google não indexar URLs temporárias de preview.
ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Banco de dados (SQLite/libSQL — mesmo dialeto do Cloudflare D1)
# Local:     file:.data/dev.db
# Produção:  libsql://<banco>-<org>.turso.io  (+ DATABASE_AUTH_TOKEN)
# ---------------------------------------------------------------------------
DATABASE_URL=file:.data/dev.db
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Armazenamento de fotos: local | vercel-blob | s3 (Cloudflare R2 ou outro S3)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# vercel-blob (store PRIVADO). Na Vercel a autenticação é automática (OIDC) ao conectar o store.
# Fora da Vercel (ex.: scripts locais) use o token:
BLOB_READ_WRITE_TOKEN=

# s3 / Cloudflare R2
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=mm-veiculos
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Autenticação do painel
# password           -> senha única (hash PBKDF2) + cookie de sessão assinado
# cloudflare-access  -> Cloudflare Access / Zero Trust (quando migrar para Cloudflare)
# ---------------------------------------------------------------------------
AUTH_MODE=password
# Gere com: npm run admin:hash-password
ADMIN_PASSWORD_HASH=
# String aleatória com 32+ caracteres (ex.: openssl rand -base64 48)
SESSION_SECRET=

# Somente para AUTH_MODE=cloudflare-access
CF_ACCESS_TEAM_DOMAIN=https://<sua-equipe>.cloudflareaccess.com
CF_ACCESS_AUD=
# Opcional: lista de e-mails autorizados, separados por vírgula
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (anti-spam do formulário "Anuncie seu veículo")
# Em desenvolvimento, se vazio, são usadas as chaves de TESTE oficiais da Cloudflare.
# Em produção as chaves reais são OBRIGATÓRIAS (o envio é bloqueado sem elas).
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sal para anonimizar IPs usados no rate limiting (string aleatória)
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Opcional: aviso por e-mail quando chegar nova proposta (Resend — plano gratuito)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=mmveiculos.sc@gmail.com
LEAD_NOTIFICATION_FROM=M&M Veículos <onboarding@resend.dev>
