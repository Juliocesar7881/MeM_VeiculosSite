{
  "name": "mm-veiculos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site e painel administrativo da M&M Veículos (Massaranduba - SC)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "cf:setup": "tsx scripts/cf-setup.ts",
    "cf:build": "tsx scripts/cf.ts build",
    "cf:deploy": "tsx scripts/cf.ts deploy",
    "cf:dev": "tsx scripts/cf.ts dev",
    "cf:migrate": "tsx scripts/cf.ts migrate",
    "cf:migrate:local": "tsx scripts/cf.ts migrate:local",
    "cf:secrets": "tsx scripts/cf-secrets.ts",
    "cf:backup": "tsx scripts/cf-backup.ts backup",
    "cf:restore": "tsx scripts/cf-backup.ts restore",
    "vercel-build": "npm run db:migrate && DEPLOY_TARGET=vercel astro build",
    "preview:local": "tsx scripts/preview-local.ts",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests scripts migrations *.mjs *.ts *.js",
    "format:check": "prettier --check src tests scripts migrations *.mjs *.ts *.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/reset-local-db.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "admin:hash-password": "tsx scripts/hash-password.ts",
    "brand:logo": "tsx scripts/build-logo.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/archivo": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "astro": "^7.3.4",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto-slab": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
