---
import PageHeader from '@/components/common/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import VehicleGrid from '@/components/vehicle/VehicleGrid.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const settings = await Astro.locals.container.settings.get();
const breadcrumbs = [
  { name: 'Início', path: '/' },
  { name: 'Favoritos', path: '/favoritos' },
];
---

<BaseLayout
  title={`Meus favoritos | ${settings.businessName}`}
  description="Veículos que você salvou para ver depois."
  canonicalPath="/favoritos"
  noindex
>
  <PageHeader
    eyebrow="Salvos neste aparelho"
    title="Favoritos"
    subtitle="Os veículos que você marcou com o coração ficam salvos neste navegador, sem cadastro."
    breadcrumbs={breadcrumbs}
  />

  <div class="container-site pt-8" data-favorites-page>
    <p class="text-sm text-mist-300" data-fav-summary aria-live="polite">
      Carregando seus favoritos…
    </p>
    <h2 class="sr-only">Veículos salvos</h2>
    <div class="mt-6" data-fav-results></div>
    <!-- Garante o CSS dos cards, que chegam depois via /favoritos/lista -->
    <VehicleGrid vehicles={[]} class="hidden" />
    <p class="mt-6 hidden text-sm text-mist-400" data-fav-removed></p>

    <div class="surface mt-2 hidden flex-col items-center px-6 py-16 text-center" data-fav-empty>
      <span class="inline-flex size-16 items-center justify-center rounded-2xl bg-white/5 text-gold-400">
        <Icon name="heart" size={32} strokeWidth={1.5} />
      </span>
      <h2 class="heading mt-6 text-2xl text-white">Nenhum favorito ainda</h2>
      <p class="mt-3 max-w-md text-mist-300">
        Toque no coração dos veículos que você gostar para encontrá-los aqui depois.
      </p>
      <a href="/estoque" class="btn btn-gold mt-8">
        Explorar estoque
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  import { initFavoritesPage } from '@/features/favorites-page';
  import { initFavoriteButtons } from '@/features/favorites-ui';
  initFavoriteButtons();
  initFavoritesPage();
</script>
