---
import EmptyState from '@/components/common/EmptyState.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import AboutBlock from '@/components/home/AboutBlock.astro';
import CategoryShortcuts from '@/components/home/CategoryShortcuts.astro';
import Hero from '@/components/home/Hero.astro';
import SellCta from '@/components/home/SellCta.astro';
import Icon from '@/components/ui/Icon.astro';
import VehicleGrid from '@/components/vehicle/VehicleGrid.astro';
import VehicleRow from '@/components/vehicle/VehicleRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dealerJsonLd, instagramUrl } from '@/lib/seo';
import { buildWhatsAppUrl, generalContactMessage } from '@/utils/whatsapp';

const { container, siteUrl } = Astro.locals;
const [settings, sections, counts, suggestions] = await Promise.all([
  container.settings.get(),
  container.vehicles.homeSections(),
  container.vehicles.countByCategory(),
  container.vehicles.searchSuggestions(),
]);

const availableCount = Object.values(counts).reduce((a, b) => a + b, 0);
const showcase = sections.featured.length ? sections.featured : sections.latest;
const whatsappUrl = buildWhatsAppUrl(settings.whatsapp, generalContactMessage(settings.businessName));
const repasseSubtitle =
  settings.repasseDescription.split('\n')[0] ||
  'Oportunidades de repasse selecionadas pela nossa equipe. Consulte as condições.';

const title = `${settings.businessName} | Carros, motos e mais em ${settings.city} - ${settings.state}`;
const description = `${settings.slogan} Compra, venda, financiamento e repasse de veículos em ${settings.city} - ${settings.state}. Veja o estoque e fale com a gente pelo WhatsApp.`;
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={[dealerJsonLd(settings, siteUrl)]}>
  <Hero settings={settings} availableCount={availableCount} suggestions={suggestions} />

  <CategoryShortcuts counts={counts} offersTotal={sections.offersTotal} repassesTotal={sections.repassesTotal} />

  <section class="container-site mt-20 sm:mt-28" aria-labelledby="destaques-title">
    {showcase.length > 0 ? (
      <>
        <SectionHeader
          id="destaques-title"
          title={sections.featured.length ? 'Destaques da M&M' : 'Novidades no estoque'}
          href="/veiculos"
          linkLabel="Ver todos os veículos"
        />
        <VehicleGrid vehicles={showcase.slice(0, 6)} hideFeatured={sections.featured.length > 0} />
      </>
    ) : (
      <>
        <h2 id="destaques-title" class="sr-only">
          Veículos
        </h2>
        <EmptyState
          title="Novos veículos em breve"
          text="Nosso estoque está sendo atualizado. Fale com a gente pelo WhatsApp para saber o que está chegando."
        >
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
            <Icon name="whatsapp" size={18} />
            Falar no WhatsApp
          </a>
          {settings.instagram && (
            <a href={instagramUrl(settings.instagram)} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
              <Icon name="instagram" size={18} />
              Ver no Instagram
            </a>
          )}
        </EmptyState>
      </>
    )}
  </section>

  {sections.offers.length > 0 && (
    <section class="offers-band mt-24 py-16 sm:mt-32 sm:py-24" aria-labelledby="ofertas-title">
      <div class="container-site">
        <SectionHeader
          id="ofertas-title"
          title="Ofertas da M&M"
          subtitle="Veículos com preço especial. Confira os valores e fale com a nossa equipe."
          href="/veiculos?oferta=true"
          linkLabel="Ver todas as ofertas"
        />
        <VehicleGrid vehicles={sections.offers.slice(0, 3)} />
      </div>
    </section>
  )}

  {sections.repasses.length > 0 && (
    <section
      class:list={['container-site', sections.offers.length > 0 ? 'mt-20 sm:mt-28' : 'mt-24 sm:mt-32']}
      aria-labelledby="repasses-title"
    >
      <SectionHeader
        id="repasses-title"
        title="Repasses"
        subtitle={repasseSubtitle}
        href="/veiculos?repasse=true"
        linkLabel="Ver todos os repasses"
      />
      <ul class="divide-y divide-white/[0.08] border-y border-white/[0.08]" role="list">
        {sections.repasses.slice(0, 4).map((vehicle) => (
          <li>
            <VehicleRow vehicle={vehicle} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-24 sm:mt-32">
    <SellCta settings={settings} />
  </div>

  <div class="mt-24 sm:mt-32">
    <AboutBlock settings={settings} />
  </div>
</BaseLayout>

<style>
  /* Faixa de ofertas: luz dourada vinda do alto, como a do hero, e fios dourados nas bordas. */
  .offers-band {
    position: relative;
    background:
      radial-gradient(60% 70% at 20% 0%, color-mix(in oklab, var(--color-gold-500) 11%, transparent), transparent 72%),
      var(--color-ink-900);
    border-block: 1px solid color-mix(in oklab, var(--color-gold-500) 18%, transparent);
  }
</style>
