---
import PageHeader from '@/components/common/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { ABOUT } from '@/config/about';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbJsonLd, dealerJsonLd, instagramUrl } from '@/lib/seo';
import { buildWhatsAppUrl, generalContactMessage } from '@/utils/whatsapp';

const { container, siteUrl } = Astro.locals;
const settings = await container.settings.get();
const breadcrumbs = [
  { name: 'Início', path: '/' },
  { name: 'Sobre nós', path: '/empresa' },
];
const whatsappUrl = buildWhatsAppUrl(settings.whatsapp, generalContactMessage(settings.businessName));
const [lead, ...story] = ABOUT.paragraphs;
const [melo, matos] = ABOUT.partners;

// Dados da empresa + fundação e sócios (schema.org) para buscadores.
const organization = {
  ...dealerJsonLd(settings, siteUrl),
  foundingDate: ABOUT.foundingDate,
  founder: ABOUT.partners.map((name) => ({ '@type': 'Person', name })),
};

const services: { icon: IconName; title: string; text: string; href?: string; cta?: string }[] = [
  {
    icon: 'car',
    title: 'Venda',
    text: 'Carros, motos, scooters, pesados e máquinas agrícolas no nosso estoque.',
    href: '/estoque',
    cta: 'Ver estoque',
  },
  {
    icon: 'handshake',
    title: 'Compra',
    text: 'Quer vender? Envie os dados do seu veículo para a nossa equipe avaliar.',
    href: '/anuncie-seu-veiculo',
    cta: settings.sellVehicleCta,
  },
  {
    icon: 'shield',
    title: 'Financiamento',
    text: 'Trabalhamos com financiamento. Consulte as condições diretamente pelo WhatsApp.',
    href: whatsappUrl,
    cta: 'Consultar',
  },
  {
    icon: 'repasse',
    title: 'Repasses',
    text: 'Oportunidades de repasse divulgadas quando disponíveis.',
    href: '/repasses',
    cta: 'Ver repasses',
  },
];
---

<BaseLayout
  title={`${ABOUT.title} | ${settings.city} - ${settings.state}`}
  description={`${lead} Compra, venda, financiamento e repasse de veículos em ${settings.city} - ${settings.state}.`}
  canonicalPath="/empresa"
  jsonLd={[organization, breadcrumbJsonLd(breadcrumbs, siteUrl)]}
>
  <PageHeader eyebrow={`${settings.city} - ${settings.state}`} title={ABOUT.title} breadcrumbs={breadcrumbs} />

  <section class="container-site py-16 sm:py-24" aria-labelledby="historia">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2.5rem)] lg:self-start">
        <h2 id="historia" class="display text-[3.1rem] text-white sm:text-7xl">
          {ABOUT.headline.split('. ').map((sentence, index, all) => (
            <span class="block">{index < all.length - 1 ? `${sentence}.` : sentence}</span>
          ))}
        </h2>

        <!-- O nome explicado: cada M é um sobrenome. -->
        <div class="name-mark mt-12" role="img" aria-label={`M&M: ${ABOUT.nameMeaning}, de ${melo} e ${matos}`}>
          <div class="nm-col">
            <span class="nm-letter">M</span>
            <span class="nm-surname">Melo</span>
            <span class="nm-person">{melo}</span>
          </div>
          <span class="nm-amp">&amp;</span>
          <div class="nm-col">
            <span class="nm-letter">M</span>
            <span class="nm-surname">Matos</span>
            <span class="nm-person">{matos}</span>
          </div>
        </div>

        <p class="milestone mt-10">
          <span class="text-mist-400">No ramo automotivo desde</span>
          <time datetime={ABOUT.foundingDate} class="title text-2xl text-white">
            {ABOUT.foundingLabel}
          </time>
        </p>
      </div>

      <div class="story">
        <p class="story-lead">{lead}</p>
        {story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="container-site" aria-labelledby="servicos">
    <h2 id="servicos" class="heading text-[2.4rem] text-white sm:text-5xl">
      O que fazemos
    </h2>
    <ul class="mt-8 border-t hairline" role="list">
      {services.map((s) => (
        <li class="service">
          <Icon name={s.icon} size={24} strokeWidth={1.6} class="service-icon" />
          <h3 class="service-title">{s.title}</h3>
          <p class="service-text">{s.text}</p>
          {s.href && (
            <a
              href={s.href}
              class="service-link group"
              {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="link-underline">{s.cta}</span>
              <Icon name="arrow-right" size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="container-site mt-20 sm:mt-28" aria-labelledby="lema">
    <div class="closing">
      <p class="closing-sign">{ABOUT.closing.signature}</p>
      <h2 id="lema" class="display closing-line">
        <span class="block text-white">{ABOUT.closing.lines[0]}</span>
        <span class="block text-gold-200">{ABOUT.closing.lines[1]}</span>
      </h2>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 xs:flex-row">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg">
          <Icon name="whatsapp" size={20} />
          Falar no WhatsApp
        </a>
        <a href="/estoque" class="btn btn-ghost btn-lg">
          Ver estoque
        </a>
      </div>
      {(settings.instagram || settings.facebook) && (
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-mist-300">
          {settings.instagram && (
            <a
              href={instagramUrl(settings.instagram)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 hover:text-white"
            >
              <Icon name="instagram" size={18} class="text-gold-400" />
              <span class="link-underline">@{settings.instagram}</span>
            </a>
          )}
          {settings.facebook && (
            <a
              href={settings.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 hover:text-white"
            >
              <Icon name="facebook" size={18} class="text-gold-400" />
              <span class="link-underline">Facebook</span>
            </a>
          )}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Nome explicado: "M & M" grandes em dourado, com o sobrenome e o sócio sob cada letra. */
  .name-mark {
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: start;
    align-items: start;
    column-gap: clamp(0.75rem, 2.5vw, 1.5rem);
  }
  .nm-col {
    display: grid;
    justify-items: start;
  }
  .nm-letter,
  .nm-amp {
    font-size: clamp(5.5rem, 3rem + 9vw, 9.5rem);
    font-stretch: 78%;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.82;
    color: var(--color-gold-400);
  }
  .nm-amp {
    color: color-mix(in oklab, var(--color-gold-400) 45%, transparent);
    font-weight: 400;
  }
  .nm-surname {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in oklab, var(--color-gold-500) 45%, transparent);
    font-size: 1.35rem;
    font-stretch: 86%;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .nm-person {
    font-size: 0.9rem;
    color: var(--color-mist-400);
  }
  /* As legendas não alargam a coluna: a largura é a da letra, e o "&" fica colado entre os dois M. */
  .nm-surname,
  .nm-person {
    width: 0;
    min-width: 100%;
    white-space: nowrap;
  }
  .milestone {
    display: grid;
    gap: 0.2rem;
  }
  /* Texto da história: medida confortável de leitura e primeiro parágrafo em destaque. */
  .story {
    max-width: 62ch;
    color: var(--color-mist-200);
    font-size: 1.075rem;
    line-height: 1.75;
  }
  .story p + p {
    margin-top: 1.4em;
  }
  .story-lead {
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.55rem);
    line-height: 1.5;
    color: var(--color-paper);
  }
  /* Fechamento com o lema da empresa, sob uma luz dourada como a do hero. */
  .closing {
    padding: clamp(3.5rem, 2rem + 6vw, 7rem) 1.5rem;
    border-radius: var(--radius-panel);
    text-align: center;
    background:
      radial-gradient(60% 90% at 50% 0%, color-mix(in oklab, var(--color-gold-500) 13%, transparent), transparent 70%),
      linear-gradient(to bottom, var(--color-ink-850), var(--color-ink-900));
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-gold-500) 18%, transparent),
      inset 0 1px 0 color-mix(in oklab, white 6%, transparent);
  }
  .closing-sign {
    font-size: 0.95rem;
    font-weight: 550;
    color: var(--color-gold-300);
  }
  .closing-line {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.5rem);
  }
  .service {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.35rem;
    align-items: baseline;
    padding-block: 1.5rem;
    border-bottom: 1px solid color-mix(in oklab, white 8%, transparent);
  }
  @media (min-width: 768px) {
    .service {
      grid-template-columns: 1.6rem minmax(0, 15rem) minmax(0, 1fr) auto;
      column-gap: 1.5rem;
      padding-block: 1.75rem;
    }
  }
  .service :global(.service-icon) {
    align-self: center;
    color: var(--color-gold-400);
  }
  .service-title {
    font-size: clamp(1.8rem, 1.3rem + 1.2vw, 2.4rem);
    font-stretch: 80%;
    font-weight: 580;
    letter-spacing: -0.025em;
    line-height: 1;
    color: #fff;
  }
  .service-text,
  .service-link {
    grid-column: 2;
  }
  .service-text {
    max-width: 52ch;
    color: var(--color-mist-300);
  }
  .service-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-gold-300);
  }
  @media (min-width: 768px) {
    .service-text {
      grid-column: 3;
    }
    .service-link {
      grid-column: 4;
      justify-self: end;
    }
  }
</style>
