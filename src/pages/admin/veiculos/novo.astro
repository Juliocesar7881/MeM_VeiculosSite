---
import { flasher } from '@/server/flash';
import PhotoManager from '@/components/admin/PhotoManager.astro';
import VehicleForm from '@/components/admin/VehicleForm.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { isAppError } from '@/lib/errors';
import { emptyVehicleValues, parseVehicleForm, type FormValues } from '@/server/vehicle-form';
import type { FieldErrors } from '@/schemas/common';
import { formDataOrEmpty } from '@/server/http';

const { container, admin } = Astro.locals;
const settings = await container.settings.get();
let values: FormValues = emptyVehicleValues(settings);
let errors: FieldErrors = {};

if (Astro.request.method === 'POST' && admin) {
  const form = await formDataOrEmpty(Astro.request);
  const parsed = parseVehicleForm(form);
  // Fotos escolhidas nesta tela: o navegador as envia logo depois (photo-manager.ts) e segue para o veículo.
  const withPhotos = Number(form.get('_fotos') ?? 0) > 0;
  values = parsed.values;
  if (parsed.ok) {
    try {
      const vehicle = await container.vehicles.create(parsed.data, admin);
      const flash = flasher(container.config);
      return Astro.redirect(
        withPhotos
          ? await flash.url(`/admin/veiculos/${vehicle.id}`, 'Veículo cadastrado com as fotos!', 'ok', 'novo-com-fotos')
          : await flash.url(
              `/admin/veiculos/${vehicle.id}#fotos`,
              'Veículo cadastrado! Agora adicione as fotos.',
              'ok',
              'novo',
            ),
        303,
      );
    } catch (error) {
      errors = { _form: isAppError(error) ? error.message : 'Não foi possível salvar. Tente novamente.' };
      if (!isAppError(error)) console.error('[admin] criar veículo', error);
    }
  } else {
    errors = parsed.errors;
  }
}

const brands = await container.vehicles.distinctBrands();
---

<AdminLayout title="Novo veículo" section="novo">
  <div class="mb-6">
    <a href="/admin/veiculos" class="text-sm text-mist-400 hover:text-white">
      ← Veículos
    </a>
    <h1 class="heading mt-2 text-3xl text-white">Novo veículo</h1>
    <p class="mt-1 text-sm text-mist-400">Preencha os dados e adicione as fotos: tudo é salvo junto.</p>
  </div>
  <VehicleForm values={values} errors={errors} brands={brands} mode="create">
    <PhotoManager slot="photos" vehicleId="" images={[]} />
  </VehicleForm>
</AdminLayout>
