---
import { flasher } from '@/server/flash';
import VehicleForm from '@/components/admin/VehicleForm.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { isAppError } from '@/lib/errors';
import { emptyVehicleValues, parseVehicleForm, type FormValues } from '@/server/vehicle-form';
import type { FieldErrors } from '@/schemas/common';
import { formDataOrEmpty } from '@/server/http';

const { container, admin } = Astro.locals;
const settings = await container.settings.get();
let values: FormValues = emptyVehicleValues(settings);
let errors: FieldErrors = {};

if (Astro.request.method === 'POST' && admin) {
  const parsed = parseVehicleForm(await formDataOrEmpty(Astro.request));
  values = parsed.values;
  if (parsed.ok) {
    try {
      const vehicle = await container.vehicles.create(parsed.data, admin);
      const flash = flasher(container.config);
      return Astro.redirect(
        await flash.url(`/admin/veiculos/${vehicle.id}#fotos`, 'Veículo cadastrado! Agora adicione as fotos.'),
        303,
      );
    } catch (error) {
      errors = { _form: isAppError(error) ? error.message : 'Não foi possível salvar. Tente novamente.' };
      if (!isAppError(error)) console.error('[admin] criar veículo', error);
    }
  } else {
    errors = parsed.errors;
  }
}

const brands = await container.vehicles.distinctBrands();
---

<AdminLayout title="Novo veículo" section="novo">
  <div class="mb-6">
    <a href="/admin/veiculos" class="text-sm text-mist-400 hover:text-white">
      ← Veículos
    </a>
    <h1 class="heading mt-2 text-3xl text-white">Novo veículo</h1>
    <ol class="steps mt-4" aria-label="Etapas do cadastro">
      <li class="step is-current" aria-current="step">
        <span class="step-dot">1</span>
        <span>Dados do veículo</span>
      </li>
      <li class="step">
        <span class="step-dot">2</span>
        <span>
          Fotos <span class="text-mist-500">(abre ao salvar)</span>
        </span>
      </li>
    </ol>
  </div>
  <VehicleForm values={values} errors={errors} brands={brands} mode="create" />
</AdminLayout>

<style>
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.9rem;
    color: var(--color-mist-400);
  }
  .step {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .step + .step::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    margin-right: 0.75rem;
    background: color-mix(in oklab, white 18%, transparent);
  }
  .step-dot {
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, white 20%, transparent);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .step.is-current {
    color: #fff;
    font-weight: 600;
  }
  .step.is-current .step-dot {
    border-color: var(--color-gold-500);
    background: var(--color-gold-500);
    color: #14110a;
  }
</style>
