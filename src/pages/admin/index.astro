---
import StatusPill from '@/components/admin/StatusPill.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { leadMediaUrl, mediaUrl } from '@/lib/storage/keys';
import { STATS_PERIOD_DAYS } from '@/services/stats-service';
import { formatRelative } from '@/utils/dates';
import { formatBRL } from '@/utils/money';
import { yearLabel } from '@/utils/vehicle-format';

const { container } = Astro.locals;
const [stats, leadCounts, latestVehicles, latestLeads, interest] = await Promise.all([
  container.vehicles.stats(),
  container.leads.countByStatus(),
  container.vehicles.listAdmin({ page: 1, pageSize: 6 }),
  container.leads.latest(6),
  container.stats.overview(5),
]);
const number = new Intl.NumberFormat('pt-BR');

const cards: { label: string; value: number; href: string; icon: IconName; accent?: boolean }[] = [
  { label: 'Total', value: stats.total - stats.archived, href: '/admin/veiculos', icon: 'car' },
  { label: 'Disponíveis', value: stats.available, href: '/admin/veiculos?status=available', icon: 'check-circle' },
  { label: 'Reservados', value: stats.reserved, href: '/admin/veiculos?status=reserved', icon: 'clock' },
  { label: 'Vendidos', value: stats.sold, href: '/admin/veiculos?status=sold', icon: 'handshake' },
  { label: 'Rascunhos', value: stats.drafts, href: '/admin/veiculos?status=draft', icon: 'wrench' },
  { label: 'Repasses', value: stats.repasses, href: '/admin/veiculos?filtro=repasses', icon: 'repasse' },
  { label: 'Ofertas ativas', value: stats.offers, href: '/admin/veiculos?filtro=ofertas', icon: 'tag' },
  {
    label: 'Novas propostas',
    value: leadCounts.new,
    href: '/admin/propostas?status=new',
    icon: 'inbox',
    accent: leadCounts.new > 0,
  },
];
---

<AdminLayout title="Dashboard" section="dashboard">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="heading text-3xl text-white">Dashboard</h1>
      <p class="mt-1 text-sm text-mist-400">Visão geral do estoque e das propostas.</p>
    </div>
    <div class="flex gap-2">
      <a href="/admin/veiculos/novo" class="btn btn-gold">
        <Icon name="plus" size={18} /> Novo veículo
      </a>
    </div>
  </div>

  <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
    {cards.map((card) => (
      <li>
        <a href={card.href} class:list={['stat', { 'is-accent': card.accent }]}>
          <span class="flex items-center justify-between text-sm text-mist-400">
            {card.label}
            <Icon name={card.icon} size={18} class={card.accent ? 'text-gold-400' : 'text-mist-500'} />
          </span>
          <span class="title mt-3 block text-4xl text-white tabular">{card.value}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-10 grid gap-6 xl:grid-cols-2">
    <section class="surface p-5 sm:p-6" aria-labelledby="ultimos-veiculos">
      <div class="flex items-center justify-between">
        <h2 id="ultimos-veiculos" class="text-lg font-bold text-white">
          Últimos veículos
        </h2>
        <a href="/admin/veiculos" class="text-sm font-semibold text-gold-300 hover:text-gold-200">
          Ver todos
        </a>
      </div>
      {latestVehicles.items.length ? (
        <ul class="mt-4 grid gap-1">
          {latestVehicles.items.map((v) => (
            <li>
              <a href={`/admin/veiculos/${v.id}`} class="mini-row">
                <span class="mini-thumb">
                  {v.cover ? (
                    <img src={mediaUrl(v.cover.thumbKey)} alt="" loading="lazy" class="h-full w-full object-cover" />
                  ) : (
                    <Icon name="image" size={18} />
                  )}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium text-white">
                    {v.brand} {v.model} {yearLabel(v)}
                  </span>
                  <span class="block text-xs text-mist-500">{formatRelative(v.updatedAt)}</span>
                </span>
                <span class="hidden text-sm font-semibold text-mist-100 tabular sm:block">
                  {v.price ? formatBRL(v.price) : '—'}
                </span>
                <StatusPill kind="vehicle" status={v.status} />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-mist-400">
          Nenhum veículo cadastrado ainda.{' '}
          <a href="/admin/veiculos/novo" class="link-underline text-gold-300">
            Cadastre o primeiro
          </a>
          .
        </p>
      )}
    </section>

    <section class="surface p-5 sm:p-6" aria-labelledby="ultimas-propostas">
      <div class="flex items-center justify-between">
        <h2 id="ultimas-propostas" class="text-lg font-bold text-white">
          Últimas propostas
        </h2>
        <a href="/admin/propostas" class="text-sm font-semibold text-gold-300 hover:text-gold-200">
          Ver todas
        </a>
      </div>
      {latestLeads.length ? (
        <ul class="mt-4 grid gap-1">
          {latestLeads.map((lead) => (
            <li>
              <a href={`/admin/propostas/${lead.id}`} class="mini-row">
                <span class="mini-thumb">
                  {lead.cover ? (
                    <img
                      src={leadMediaUrl(lead.cover.thumbKey)}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <Icon name="image" size={18} />
                  )}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium text-white">
                    {lead.brand} {lead.model} {yearLabel(lead)}
                  </span>
                  <span class="block truncate text-xs text-mist-500">
                    {lead.name} · {formatRelative(lead.createdAt)}
                  </span>
                </span>
                <StatusPill kind="lead" status={lead.status} />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-mist-400">Nenhuma proposta recebida ainda.</p>
      )}
    </section>
  </div>

  <section class="surface mt-6 p-5 sm:p-6" aria-labelledby="interesse">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="interesse" class="text-lg font-bold text-white">
          Interesse nos últimos {STATS_PERIOD_DAYS} dias
        </h2>
        <p class="mt-1 text-xs text-mist-500">
          Contagem anônima (sem cookies): visitas às páginas dos veículos e toques nos botões de WhatsApp.
        </p>
      </div>
      <p class="flex gap-5 text-sm text-mist-300">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="eye" size={16} class="text-mist-500" />
          <strong class="text-white tabular">{number.format(interest.views)}</strong> visualizações
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="whatsapp" size={16} class="text-[#25d366]" />
          <strong class="text-white tabular">{number.format(interest.whatsappClicks)}</strong> cliques no WhatsApp
        </span>
      </p>
    </div>
    {interest.top.length ? (
      <ol class="mt-4 grid gap-1">
        {interest.top.map((row, index) => (
          <li>
            <a href={`/admin/veiculos/${row.vehicleId}`} class="mini-row">
              <span class="w-6 text-center text-sm font-bold text-mist-500 tabular">{index + 1}</span>
              <span class="min-w-0 flex-1 truncate font-medium text-white">
                {row.brand} {row.model} {yearLabel(row)}
              </span>
              <span class="text-sm text-mist-300 tabular" title="Visualizações">
                <Icon name="eye" size={14} class="mr-1 inline text-mist-500" />
                {number.format(row.views)}
              </span>
              <span class="w-16 text-right text-sm font-semibold text-white tabular" title="Cliques no WhatsApp">
                <Icon name="whatsapp" size={14} class="mr-1 inline text-[#25d366]" />
                {number.format(row.whatsappClicks)}
              </span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="mt-4 text-sm text-mist-400">
        Ainda sem dados. Os números aparecem conforme os clientes visitam os veículos publicados.
      </p>
    )}
  </section>
</AdminLayout>

<style>
  .stat {
    display: block;
    padding: 1.1rem 1.2rem;
    border-radius: 1rem;
    background: var(--color-ink-850);
    border: 1px solid color-mix(in oklab, white 7%, transparent);
    transition: border-color 140ms ease;
  }
  .stat:hover {
    border-color: color-mix(in oklab, var(--color-gold-500) 45%, transparent);
  }
  .stat.is-accent {
    border-color: color-mix(in oklab, var(--color-gold-500) 55%, transparent);
    background: color-mix(in oklab, var(--color-gold-500) 7%, var(--color-ink-850));
  }
  .mini-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem;
    border-radius: 0.7rem;
    transition: background-color 140ms ease;
  }
  .mini-row:hover {
    background: color-mix(in oklab, white 4%, transparent);
  }
  .mini-thumb {
    display: grid;
    width: 3.6rem;
    aspect-ratio: 4 / 3;
    flex: none;
    place-items: center;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--color-ink-800);
    color: var(--color-mist-500);
  }
</style>
