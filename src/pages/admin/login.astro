---
import '@/styles/global.css';
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { authConfigProblem, authenticateAdmin, safeAdminRedirect, startAdminSession } from '@/server/admin-auth';
import { attemptAdminLogin } from '@/server/admin-login';
import { clientIp, contentLength, socketAddressOf } from '@/server/http';

/** Tamanho máximo do envio do login (a senha tem no máximo 256 caracteres). */
const LOGIN_MAX_BODY = 4096;

const { container } = Astro.locals;
const { config } = container;
const next = safeAdminRedirect(Astro.url.searchParams.get('next'));
const problem = authConfigProblem(config);
const sessionsValidAfter = () => container.settings.sessionsValidAfter();
let error: string | null = null;

if (config.auth.mode === 'cloudflare-access') {
  // Com Cloudflare Access o login é feito na borda (Zero Trust). Aqui só confirmamos.
  const actor = await authenticateAdmin(Astro.request, Astro.cookies, config, sessionsValidAfter);
  if (actor) return Astro.redirect(next, 303);
} else if (!problem) {
  if (Astro.request.method === 'GET') {
    const actor = await authenticateAdmin(Astro.request, Astro.cookies, config, sessionsValidAfter);
    if (actor) return Astro.redirect(next, 303);
  }

  if (Astro.request.method === 'POST') {
    const ip = clientIp(Astro.request, socketAddressOf(Astro), container.platform.name);
    // O corpo só é lido se o IP não estiver bloqueado, e só se for pequeno (o formulário tem ~100 bytes):
    // um envio gigante ou sem tamanho declarado conta como senha errada, sem ocupar a memória do servidor.
    const length = contentLength(Astro.request);
    const readPassword = async () =>
      length !== null && length <= LOGIN_MAX_BODY
        ? String((await Astro.request.formData().catch(() => null))?.get('password') ?? '')
        : '';
    const result = await attemptAdminLogin(container.rateLimiter, ip, readPassword, config.auth.passwordHash as string);
    if (result.ok) {
      await startAdminSession(Astro.cookies, config, Astro.url.protocol === 'https:');
      await container.audit.log('Administrador', 'auth.login', 'session', null);
      return Astro.redirect(next, 303);
    }
    error = result.error;
  }
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Entrar · Painel M&M Veículos</title>
  </head>
  <body class="grid min-h-dvh place-items-center bg-ink-950 px-4 py-10">
    <main class="w-full max-w-sm">
      <div class="mb-8 flex justify-center">
        <Logo height={52} priority class="h-13 w-auto" />
      </div>
      <div class="surface p-6 sm:p-8">
        <h1 class="heading text-2xl text-white">Painel administrativo</h1>
        {config.auth.mode === 'cloudflare-access' ? (
          <p class="mt-3 text-sm text-mist-300">
            O acesso é protegido pelo Cloudflare Access. Entre pelo link do painel usando o e-mail autorizado.
          </p>
        ) : problem ? (
          <div class="mt-4 rounded-lg bg-danger/15 p-4 text-sm text-red-200">
            <p class="font-semibold">Login não configurado.</p>
            <p class="mt-1">
              Defina <code>ADMIN_PASSWORD_HASH</code> (gere com <code>npm run admin:hash-password</code>) e
              <code>SESSION_SECRET</code> (32+ caracteres) nas variáveis de ambiente.
            </p>
          </div>
        ) : (
          <form method="post" class="mt-6 grid gap-4">
            <div>
              <label for="password" class="field-label">
                Senha
              </label>
              <input
                id="password"
                name="password"
                type="password"
                class="input"
                autocomplete="current-password"
                required
                autofocus
                aria-invalid={error ? 'true' : undefined}
                aria-describedby={error ? 'login-error' : undefined}
              />
              {error && (
                <p id="login-error" class="field-error" role="alert">
                  {error}
                </p>
              )}
            </div>
            <button type="submit" class="btn btn-gold btn-lg w-full">
              <Icon name="lock" size={18} />
              Entrar
            </button>
          </form>
        )}
      </div>
      <p class="mt-6 text-center text-sm text-mist-500">
        <a href="/" class="hover:text-mist-300">
          ← Voltar ao site
        </a>
      </p>
    </main>
  </body>
</html>
