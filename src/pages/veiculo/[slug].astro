---
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import Badges from '@/components/vehicle/Badges.astro';
import FavoriteButton from '@/components/vehicle/FavoriteButton.astro';
import Gallery from '@/components/vehicle/Gallery.astro';
import PriceTag from '@/components/vehicle/PriceTag.astro';
import VehicleGrid from '@/components/vehicle/VehicleGrid.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORY_INFO } from '@/config/catalog';
import { mediaUrl } from '@/lib/storage/keys';
import { absoluteUrl, breadcrumbJsonLd, vehicleJsonLd } from '@/lib/seo';
import { isValidSlug } from '@/utils/slug';
import { formatDate } from '@/utils/dates';
import { formatBRL } from '@/utils/money';
import { getPriceDisplay, isOfferActive } from '@/utils/offer';
import {
  fuelLabel,
  hoursLabel,
  locationLabel,
  mileageLabel,
  transmissionLabel,
  usageLabel,
  vehicleFullName,
  vehicleName,
  yearLabel,
} from '@/utils/vehicle-format';
import { buildWhatsAppUrl, financingMessage, soldVehicleMessage, vehicleInterestMessage } from '@/utils/whatsapp';

const slug = Astro.params.slug ?? '';
const { container, siteUrl } = Astro.locals;
const result = isValidSlug(slug) ? await container.vehicles.getPublicBySlug(slug) : ({ kind: 'not-found' } as const);
if (result.kind === 'redirect') return Astro.redirect(`/veiculo/${result.slug}`, 301);
if (result.kind === 'not-found') {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const vehicle = result.vehicle;
const settings = await container.settings.get();
const similar = await container.vehicles.listSimilar(vehicle, 4);

const pagePath = `/veiculo/${vehicle.slug}`;
const pageUrl = absoluteUrl(siteUrl, pagePath);
const fullName = vehicleFullName(vehicle);
const years = yearLabel(vehicle);
const sold = vehicle.status === 'sold';
const reserved = vehicle.status === 'reserved';
const repasse = vehicle.commercialType === 'repasse';
const offerActive = isOfferActive(vehicle);
const price = getPriceDisplay(vehicle);
const location = locationLabel(vehicle.city, vehicle.state) || `${settings.city} - ${settings.state}`;

const interestUrl = buildWhatsAppUrl(
  settings.whatsapp,
  vehicleInterestMessage(vehicle, pageUrl, settings.businessName),
);
const similarUrl = buildWhatsAppUrl(settings.whatsapp, soldVehicleMessage(vehicle, pageUrl));
const financingUrl = buildWhatsAppUrl(settings.whatsapp, financingMessage(vehicle, pageUrl));

const highlightItems: { icon: IconName; label: string; value: string }[] = [
  { icon: 'calendar', label: 'Ano', value: years },
  {
    icon: 'gauge',
    label: CATEGORY_INFO[vehicle.category].usesHours && vehicle.usageHours !== null ? 'Horas' : 'Quilometragem',
    value: usageLabel(vehicle),
  },
  { icon: 'gear', label: 'Câmbio', value: transmissionLabel(vehicle.transmission) },
  { icon: 'fuel', label: 'Combustível', value: fuelLabel(vehicle.fuel) },
];
const highlights = highlightItems.filter((h) => h.value);

const specs: [string, string][] = (
  [
    ['Marca', vehicle.brand],
    ['Modelo', vehicle.model],
    ['Versão', vehicle.version ?? ''],
    ['Ano de fabricação', vehicle.manufactureYear ? String(vehicle.manufactureYear) : ''],
    ['Ano modelo', vehicle.modelYear ? String(vehicle.modelYear) : ''],
    ['Quilometragem', mileageLabel(vehicle.mileage)],
    ['Horas de uso', hoursLabel(vehicle.usageHours)],
    ['Cor', vehicle.color ?? ''],
    ['Combustível', fuelLabel(vehicle.fuel)],
    ['Câmbio', transmissionLabel(vehicle.transmission)],
    ['Carroceria', vehicle.bodyType ?? ''],
    ['Categoria', CATEGORY_INFO[vehicle.category].label],
    ['Localização', location],
  ] as [string, string][]
).filter(([, value]) => value);

const breadcrumbs = [
  { name: 'Início', path: '/' },
  { name: 'Estoque', path: '/estoque' },
  { name: CATEGORY_INFO[vehicle.category].plural, path: `/estoque?categoria=${CATEGORY_INFO[vehicle.category].slug}` },
  { name: vehicleName(vehicle), path: pagePath },
];

const priceText = sold ? 'Vendido' : price.current ? formatBRL(price.current) : 'Preço sob consulta';
const title = `${fullName} ${years} — ${priceText} | ${settings.businessName}`;
const description = [
  `${fullName} ${years}`.trim(),
  usageLabel(vehicle),
  transmissionLabel(vehicle.transmission),
  fuelLabel(vehicle.fuel),
  repasse ? 'Veículo de repasse' : '',
  location,
]
  .filter(Boolean)
  .join(' · ')
  .concat(`. ${sold ? 'Vendido' : priceText}. Fale com a ${settings.businessName} pelo WhatsApp.`);

const cover = vehicle.images[0] ?? null;
const ogImage = cover ? `/og/veiculo/${vehicle.id}/${cover.id}.jpg` : '/og-default.jpg';
const preload = cover
  ? {
      href: mediaUrl(cover.largeKey),
      srcset: `${mediaUrl(cover.thumbKey)} ${cover.thumbWidth}w, ${mediaUrl(cover.largeKey)} ${cover.width}w`,
      sizes: '(min-width: 1280px) 58vw, (min-width: 1024px) 56vw, 100vw',
    }
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={pagePath}
  type="product"
  image={ogImage}
  imageAlt={`${fullName} ${years}`}
  hideTabBar
  preloadImage={preload}
  jsonLd={[vehicleJsonLd(vehicle, settings, siteUrl, pageUrl), breadcrumbJsonLd(breadcrumbs, siteUrl)]}
>
  <div class="container-site pb-28 pt-5 lg:pb-8">
    <Breadcrumbs items={breadcrumbs} class="mb-5" />

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-10 xl:gap-14">
      <!-- Galeria -->
      <div class="min-w-0">
        <Gallery images={vehicle.images} alt={`${fullName} ${years}`} sold={sold} />
      </div>

      <!-- Resumo e ação -->
      <aside class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start" aria-label="Resumo do veículo">
        <Badges vehicle={vehicle} max={3} />
        <p class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">{vehicle.brand}</p>
        <h1 class="display mt-2 text-4xl text-white sm:text-5xl">
          {vehicle.model}
          {vehicle.version && (
            <span class="mt-1 block text-lg font-medium text-mist-300 [font-stretch:100%] sm:text-xl">
              {vehicle.version}
            </span>
          )}
        </h1>

        {highlights.length > 0 && (
          <ul class="mt-6 grid grid-cols-2 gap-2.5">
            {highlights.map((h) => (
              <li class="spec-tile">
                <span class="spec-icon" aria-hidden="true">
                  <Icon name={h.icon} size={17} />
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-[0.68rem] font-semibold uppercase tracking-wider text-mist-400">
                    {h.label}
                  </span>
                  <span class="block truncate font-semibold text-white tabular">{h.value}</span>
                </span>
              </li>
            ))}
          </ul>
        )}

        <div class="price-card mt-6 p-5 sm:p-6">
          {sold ? (
            <div>
              <p class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em] text-[#ff8a8f]">
                <span class="size-2 rounded-full bg-sold" /> Veículo vendido
              </p>
              <p class="heading mt-3 text-2xl text-white">Procurando algo parecido?</p>
              <p class="mt-2 text-sm text-mist-300">Fale com a nossa equipe e conte o que você procura.</p>
              <a
                href={similarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp btn-lg mt-5 w-full"
              >
                <Icon name="whatsapp" size={20} />
                Procurar algo parecido
              </a>
              <a href="/estoque" class="btn btn-ghost mt-3 w-full">
                Ver estoque disponível
              </a>
            </div>
          ) : (
            <div>
              <PriceTag vehicle={vehicle} size="lg" />
              {offerActive && vehicle.offerEndAt && price.previous !== null && (
                <p class="mt-2 text-sm text-gold-300">Oferta válida até {formatDate(vehicle.offerEndAt)}.</p>
              )}
              {reserved && (
                <p class="mt-3 rounded-lg bg-[color-mix(in_oklab,var(--color-reserved)_14%,transparent)] px-3 py-2 text-sm text-[#fdd9b0]">
                  Este veículo está reservado. Fale com a gente para entrar na lista de interesse.
                </p>
              )}
              <a
                href={interestUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp btn-lg mt-5 w-full"
                data-track="whatsapp-interest"
              >
                <Icon name="whatsapp" size={20} />
                Tenho interesse
              </a>
              <a href={financingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-gold mt-3 w-full">
                <Icon name="shield" size={18} />
                Simular financiamento
              </a>
              <p class="mt-3 text-center text-xs text-mist-400">
                Trabalhamos com financiamento — consulte as condições com a nossa equipe.
              </p>
            </div>
          )}
          <div class="mt-5 grid grid-cols-2 gap-2 border-t hairline pt-5">
            <FavoriteButton id={vehicle.id} name={vehicleName(vehicle)} variant="solid" class="relative w-full" />
            <button
              type="button"
              class="btn btn-ghost w-full"
              data-share
              data-share-url={pageUrl}
              data-share-title={`${fullName} ${years}`}
            >
              <Icon name="share" size={18} />
              <span data-share-label>Compartilhar</span>
            </button>
          </div>
        </div>

        {repasse && (
          <div class="mt-4 flex gap-3 rounded-2xl border border-silver-300/25 bg-silver-300/[0.04] p-4 text-sm">
            <Icon name="repasse" size={20} class="mt-0.5 shrink-0 text-silver-300" />
            <div>
              <p class="font-semibold text-white">Veículo de repasse</p>
              <p class="mt-1 whitespace-pre-line text-mist-300">
                {settings.repasseDescription || 'Consulte as condições deste repasse diretamente com a nossa equipe.'}
              </p>
            </div>
          </div>
        )}

        <p class="mt-4 flex items-center gap-2 text-sm text-mist-400">
          <Icon name="map-pin" size={16} />
          {location}
        </p>
      </aside>
    </div>

    <!-- Detalhes -->
    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-10 xl:gap-14">
      <div class="min-w-0 space-y-12">
        {vehicle.description && (
          <section aria-labelledby="descricao">
            <h2 id="descricao" class="heading text-2xl text-white">
              Sobre este veículo
            </h2>
            <div class="prose-mm mt-4 whitespace-pre-line">{vehicle.description}</div>
          </section>
        )}

        {vehicle.features.length > 0 && (
          <section aria-labelledby="opcionais">
            <h2 id="opcionais" class="heading text-2xl text-white">
              Opcionais
            </h2>
            <ul class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              {vehicle.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-mist-100">
                  <Icon name="check-circle" size={19} class="mt-0.5 shrink-0 text-gold-400" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <section aria-labelledby="ficha">
        <h2 id="ficha" class="heading text-2xl text-white">
          Ficha técnica
        </h2>
        <dl class="surface mt-5 divide-y divide-white/[0.07] px-5">
          {specs.map(([label, value]) => (
            <div class="flex items-center justify-between gap-4 py-3.5 text-sm">
              <dt class="text-mist-400">{label}</dt>
              <dd class="text-right font-medium text-white tabular">{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    {similar.length > 0 && (
      <section class="mt-20" aria-labelledby="semelhantes">
        <SectionHeader
          id="semelhantes"
          eyebrow="Continue procurando"
          title="Veículos semelhantes"
          href={`/estoque?categoria=${CATEGORY_INFO[vehicle.category].slug}`}
          linkLabel="Ver mais"
        />
        <VehicleGrid vehicles={similar.slice(0, 3)} />
      </section>
    )}
  </div>

  <!-- Barra fixa de ação no celular -->
  <div slot="after" class="mobile-cta flex lg:hidden">
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs text-mist-400">
        {vehicleName(vehicle)} {years}
      </p>
      <p class="truncate text-lg font-extrabold text-white tabular [font-stretch:108%]">
        {sold ? 'Vendido' : price.current ? formatBRL(price.current) : 'Sob consulta'}
      </p>
    </div>
    <a
      href={sold ? similarUrl : interestUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp shrink-0"
    >
      <Icon name="whatsapp" size={19} />
      {sold ? 'Algo parecido?' : 'Tenho interesse'}
    </a>
  </div>
</BaseLayout>

<style>
  .spec-tile {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.9rem;
    border-radius: 1rem;
    background: linear-gradient(180deg, var(--color-ink-800), var(--color-ink-850));
    border: 1px solid color-mix(in oklab, white 7%, transparent);
  }
  .spec-icon {
    display: none;
    width: 2.2rem;
    height: 2.2rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-gold-500) 12%, transparent);
    color: var(--color-gold-300);
  }
  /* Em telas muito estreitas o ícone some para o rótulo caber. */
  @media (min-width: 400px) {
    .spec-icon {
      display: inline-flex;
    }
  }
  .price-card {
    position: relative;
    border-radius: 1.5rem;
    background:
      radial-gradient(90% 60% at 100% 0%, color-mix(in oklab, var(--color-gold-500) 11%, transparent), transparent 60%),
      linear-gradient(180deg, var(--color-ink-800), var(--color-ink-900));
    border: 1px solid color-mix(in oklab, var(--color-gold-500) 22%, transparent);
    box-shadow: 0 40px 80px -50px rgb(0 0 0 / 0.95);
  }
  .price-card::before {
    content: '';
    position: absolute;
    inset-inline: 1.5rem;
    top: -1px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-gold-400), transparent);
  }
  .mobile-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 35;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: color-mix(in oklab, var(--color-ink-950) 94%, transparent);
    backdrop-filter: blur(14px);
    border-top: 1px solid color-mix(in oklab, white 8%, transparent);
  }
</style>

<script>
  import { initShareButtons } from '@/features/share';
  initShareButtons();
</script>
