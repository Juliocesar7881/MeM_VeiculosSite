---
import PageHeader from '@/components/common/PageHeader.astro';
import InventoryView from '@/components/inventory/InventoryView.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import { inventoryHref } from '@/schemas/filters';
import { loadInventoryPage } from '@/server/inventory-page';

const data = await loadInventoryPage(Astro, 'offers');
if (data.redirectTo) return Astro.redirect(inventoryHref(data.redirectTo, {}, '/ofertas'), 302);

const { settings, filters, result, facets, isFiltered } = data;
const breadcrumbs = [
  { name: 'Início', path: '/' },
  { name: 'Ofertas', path: '/ofertas' },
];
---

<BaseLayout
  title={`Ofertas de veículos | ${settings.businessName}`}
  description={`Veículos com condição especial de preço na ${settings.businessName}, em ${settings.city} - ${settings.state}. Confira as ofertas e fale pelo WhatsApp.`}
  canonicalPath="/ofertas"
  noindex={isFiltered}
  jsonLd={[breadcrumbJsonLd(breadcrumbs, Astro.locals.siteUrl)]}
>
  <PageHeader
    tone="gold"
    eyebrow="Condição especial"
    title="Ofertas da M&M"
    subtitle="Veículos com preço especial por decisão da nossa equipe. Os valores exibidos podem mudar sem aviso — confirme pelo WhatsApp."
    breadcrumbs={breadcrumbs}
  />
  <div class="container-site pt-8">
    <InventoryView
      filters={filters}
      result={result}
      facets={facets}
      settings={settings}
      basePath="/ofertas"
      locked="offers"
    />
  </div>
</BaseLayout>
