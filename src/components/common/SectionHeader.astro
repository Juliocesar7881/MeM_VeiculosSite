---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
  as?: 'h1' | 'h2';
}

const { eyebrow, title, subtitle, href, linkLabel = 'Ver todos', id, as: Heading = 'h2' } = Astro.props;
---

<div class="mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <Heading id={id} class="heading text-[2.4rem] text-white sm:text-5xl">
      {title}
    </Heading>
    {subtitle && <p class="mt-4 max-w-[60ch] text-base text-mist-300 sm:text-lg">{subtitle}</p>}
  </div>
  {href && (
    <a
      href={href}
      class="group inline-flex min-h-11 shrink-0 items-center gap-2 text-[0.95rem] font-medium text-gold-300 hover:text-gold-200"
    >
      <span class="link-underline">{linkLabel}</span>
      <Icon
        name="arrow-right"
        size={18}
        class="transition-transform duration-200 ease-out-soft group-hover:translate-x-1"
      />
    </a>
  )}
</div>
