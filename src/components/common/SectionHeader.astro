---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
  as?: 'h1' | 'h2';
}

const { eyebrow, title, subtitle, href, linkLabel = 'Ver todos', id, as: Heading = 'h2' } = Astro.props;
---

<div class="mb-7 flex flex-col gap-4 sm:mb-9 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading id={id} class="heading mt-3 text-3xl text-white sm:text-4xl">
      {title}
    </Heading>
    {subtitle && <p class="mt-3 text-base text-mist-300 sm:text-lg">{subtitle}</p>}
  </div>
  {href && (
    <a
      href={href}
      class="group inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-gold-300 hover:text-gold-200"
    >
      {linkLabel}
      <Icon name="arrow-right" size={18} class="transition-transform duration-200 group-hover:translate-x-1" />
    </a>
  )}
</div>
