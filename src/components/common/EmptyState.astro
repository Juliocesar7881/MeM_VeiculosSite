---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

interface Props {
  icon?: IconName;
  title: string;
  text?: string;
  class?: string;
}

const { icon = 'car', title, text, class: className } = Astro.props;
---

<div class:list={['surface flex flex-col items-center px-6 py-14 text-center sm:py-20', className]}>
  <span class="inline-flex size-16 items-center justify-center rounded-2xl bg-white/5 text-gold-400">
    <Icon name={icon} size={32} strokeWidth={1.5} />
  </span>
  <h2 class="heading mt-6 text-2xl text-white">{title}</h2>
  {text && <p class="mt-3 max-w-md text-mist-300">{text}</p>}
  <div class="mt-8 flex flex-col gap-3 xs:flex-row">
    <slot />
  </div>
</div>
