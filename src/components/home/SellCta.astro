---
import { LOGO_GOLD_PATHS, LOGO_VIEWBOX } from '@/components/brand/logo-data';
import Icon from '@/components/ui/Icon.astro';
import type { SiteSettings } from '@/types/settings';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const steps = [
  { icon: 'send' as const, title: 'Você envia os dados', text: 'Informações e fotos do veículo, em poucos minutos.' },
  { icon: 'search' as const, title: 'A M&M analisa', text: 'Nossa equipe avalia as informações enviadas.' },
  { icon: 'whatsapp' as const, title: 'Entramos em contato', text: 'Retornamos pelo WhatsApp para conversar.' },
];
---

<section class="theme-light sell relative isolate overflow-hidden py-16 sm:py-24" aria-labelledby="venda-title">
  <svg viewBox={LOGO_VIEWBOX} class="sell-art" aria-hidden="true">
    {LOGO_GOLD_PATHS.map((d) => (
      <path d={d} fill="currentColor" />
    ))}
  </svg>
  <div class="container-site relative grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">Venda com a M&M</p>
      <h2 id="venda-title" class="display mt-4 text-4xl text-ink-950 sm:text-6xl">
        Quer vender seu <span class="sell-highlight">veículo?</span>
      </h2>
      <p class="mt-5 max-w-md text-lg text-ink-600">
        Envie os dados e as fotos do seu veículo. Nossa equipe avalia e retorna pelo WhatsApp.
      </p>
      <div class="mt-8 flex flex-col gap-3 xs:flex-row">
        <a href="/anuncie-seu-veiculo" class="btn btn-dark btn-lg">
          Quero vender meu veículo
          <Icon name="arrow-right" size={18} class="text-gold-400" />
        </a>
      </div>
      <p class="mt-4 text-sm text-ink-500">Sem compromisso. O envio não garante a compra do veículo.</p>
    </div>
    <ol class="grid gap-3.5">
      {steps.map((step, index) => (
        <li class="step reveal">
          <span class="step-num tabular">{String(index + 1).padStart(2, '0')}</span>
          <div class="min-w-0">
            <p class="flex items-center gap-2 text-lg font-bold text-ink-950 [font-stretch:106%]">{step.title}</p>
            <p class="mt-1 text-ink-600">{step.text}</p>
          </div>
          <span class="step-icon" aria-hidden="true">
            <Icon name={step.icon} size={20} />
          </span>
        </li>
      ))}
    </ol>
  </div>
  <span class="sr-only">{settings.sellVehicleCta}</span>
</section>

<style>
  .sell {
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(242 193 46 / 0.22), transparent 60%),
      radial-gradient(60% 80% at 0% 100%, rgb(242 193 46 / 0.1), transparent 60%), #f3f2ee;
  }
  .sell-art {
    position: absolute;
    right: -8%;
    bottom: -22%;
    z-index: -1;
    width: min(62rem, 90%);
    color: rgb(168 130 12 / 0.09);
    pointer-events: none;
  }
  .sell-highlight {
    position: relative;
    white-space: nowrap;
  }
  .sell-highlight::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: 0.04em;
    z-index: -1;
    height: 0.34em;
    border-radius: 0.1em;
    background: var(--gold-button);
  }
  .step {
    display: flex;
    gap: 1.1rem;
    align-items: center;
    padding: 1.2rem 1.3rem;
    border-radius: 1.25rem;
    background: #fff;
    border: 1px solid rgb(21 23 26 / 0.07);
    box-shadow: 0 18px 40px -28px rgb(21 23 26 / 0.45);
  }
  .step-num {
    flex: none;
    font-size: 1.9rem;
    font-weight: 800;
    font-stretch: 115%;
    line-height: 1;
    background: var(--gold-metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 0 rgb(168 130 12 / 0.35));
  }
  .step-icon {
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    margin-left: auto;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-ink-950);
    color: var(--color-gold-400);
  }
</style>
