---
import { LOGO_GOLD_PATHS, LOGO_VIEWBOX } from '@/components/brand/logo-data';
import Icon from '@/components/ui/Icon.astro';
import type { SiteSettings } from '@/types/settings';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
// Os passos são uma sequência de verdade, por isso a numeração.
const steps = [
  { title: 'Você envia os dados', text: 'Informações e fotos do veículo, em poucos minutos.' },
  { title: 'A M&M analisa', text: 'Nossa equipe avalia as informações enviadas.' },
  { title: 'Entramos em contato', text: 'Retornamos pelo WhatsApp para conversar.' },
];
---

<section class="container-site" aria-labelledby="venda-title">
  <div class="sell-cta relative overflow-hidden px-6 py-10 sm:px-10 sm:py-14 lg:px-16 lg:py-20">
    <svg viewBox={LOGO_VIEWBOX} class="sell-art" aria-hidden="true">
      {LOGO_GOLD_PATHS.map((d) => (
        <path d={d} fill="currentColor" />
      ))}
    </svg>
    <div class="relative grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-20">
      <div>
        <h2 id="venda-title" class="display text-[2.9rem] text-white sm:text-6xl xl:text-7xl">
          Quer vender seu veículo?
        </h2>
        <p class="mt-5 max-w-md text-lg text-mist-200">Envie os dados do seu veículo para nossa equipe avaliar.</p>
        <a href="/anuncie-seu-veiculo" class="btn btn-gold btn-lg mt-8">
          Quero vender meu veículo
          <Icon name="arrow-right" size={18} class="btn-arrow" />
        </a>
        <p class="mt-4 text-sm text-mist-400">Sem compromisso. O envio não garante a compra do veículo.</p>
      </div>
      <ol class="steps" role="list">
        {steps.map((step, index) => (
          <li class="step">
            <span class="step-num tabular" aria-hidden="true">
              {index + 1}
            </span>
            <div class="pb-1">
              <h3 class="title text-xl text-white">
                <span class="sr-only">Passo {index + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-1 text-mist-300">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <span class="sr-only">{settings.sellVehicleCta}</span>
  </div>
</section>

<style>
  .sell-cta {
    border-radius: var(--radius-panel);
    background:
      radial-gradient(
        70% 110% at 100% 0%,
        color-mix(in oklab, var(--color-gold-500) 13%, transparent),
        transparent 62%
      ),
      linear-gradient(165deg, var(--color-ink-800), var(--color-ink-900) 70%);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-gold-500) 20%, transparent),
      inset 0 1px 0 color-mix(in oklab, white 6%, transparent);
  }
  .sell-art {
    position: absolute;
    right: -8%;
    bottom: -22%;
    width: 72%;
    color: color-mix(in oklab, var(--color-gold-500) 7%, transparent);
    pointer-events: none;
  }
  /* Linha do tempo: números ligados por um fio dourado que se apaga no último passo. */
  .steps {
    display: grid;
    gap: 2rem;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1.25rem;
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.375rem - 0.5px);
    top: 3.25rem;
    bottom: -1.5rem;
    width: 1px;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-gold-500) 55%, transparent),
      color-mix(in oklab, var(--color-gold-500) 10%, transparent)
    );
  }
  /* O fio se desenha de cima para baixo conforme a lista entra na tela (CSS scroll-driven). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .step:not(:last-child)::before {
        transform-origin: top;
        animation: draw-line linear both;
        animation-timeline: view();
        animation-range: entry 60% cover 55%;
      }
    }
  }
  @keyframes draw-line {
    from {
      transform: scaleY(0);
    }
  }
  .step-num {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-gold-500) 60%, transparent);
    background: color-mix(in oklab, var(--color-gold-500) 10%, var(--color-ink-900));
    color: var(--color-gold-300);
    font-size: 1.05rem;
    font-weight: 600;
    font-stretch: 85%;
  }
</style>
