---
import { LOGO_GOLD_PATHS, LOGO_SILVER_PATH, LOGO_VIEWBOX } from '@/components/brand/logo-data';
import Icon from '@/components/ui/Icon.astro';
import PriceTag from '@/components/vehicle/PriceTag.astro';
import { CATEGORY_INFO, VEHICLE_CATEGORIES, type VehicleCategory } from '@/config/catalog';
import { mediaUrl } from '@/lib/storage/keys';
import type { VehicleCard } from '@/types/domain';
import type { SiteSettings } from '@/types/settings';
import { usageLabel, vehicleName, yearLabel } from '@/utils/vehicle-format';
import { buildWhatsAppUrl, generalContactMessage } from '@/utils/whatsapp';

interface Props {
  settings: SiteSettings;
  spotlight: VehicleCard | null;
  availableCount: number;
  suggestions: string[];
}

const { settings, spotlight, availableCount, suggestions } = Astro.props;
const whatsappUrl = buildWhatsAppUrl(settings.whatsapp, generalContactMessage(settings.businessName));
const cover = spotlight?.cover ?? null;

/** Rótulos curtos para os filtros rápidos da busca. */
const SHORT: Record<VehicleCategory, string> = {
  carro: 'Carros',
  moto: 'Motos',
  scooter: 'Scooters',
  pesado: 'Pesados',
  maquina_agricola: 'Máquinas',
};
const spotlightSpecs = spotlight
  ? [spotlight.version, yearLabel(spotlight), usageLabel(spotlight)].filter(Boolean).join(' · ')
  : '';
---

<section class:list={['hero relative isolate overflow-hidden', { 'has-media': cover }]} aria-labelledby="hero-title">
  {spotlight && cover ? (
    <div class="hero-media">
      <img
        src={mediaUrl(cover.largeKey)}
        srcset={`${mediaUrl(cover.thumbKey)} ${cover.thumbWidth}w, ${mediaUrl(cover.largeKey)} ${cover.width}w`}
        sizes="(min-width: 1024px) 64vw, 100vw"
        width={cover.width}
        height={cover.height}
        alt={`${vehicleName(spotlight)} ${spotlight.version ?? ''}`.trim()}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-img"
      />
      {/* Celular: resumo do destaque sobre a foto */}
      <a href={`/veiculo/${spotlight.slug}`} class="spot-chip glass">
        <span class="min-w-0">
          <span class="block text-[0.62rem] font-bold uppercase tracking-[0.18em] text-gold-300">Em destaque</span>
          <span class="block truncate font-bold text-white [font-stretch:108%]">{vehicleName(spotlight)}</span>
        </span>
        <PriceTag vehicle={spotlight} class="spot-chip-price shrink-0" />
        <span class="spot-arrow" aria-hidden="true">
          <Icon name="arrow-up-right" size={18} />
        </span>
      </a>
    </div>
  ) : (
    <div class="hero-art" aria-hidden="true">
      <svg viewBox={LOGO_VIEWBOX} class="w-full">
        {LOGO_GOLD_PATHS.map((d) => (
          <path d={d} fill="var(--color-gold-500)" />
        ))}
        <path d={LOGO_SILVER_PATH} fill="var(--color-silver-300)" />
      </svg>
    </div>
  )}
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="bg-grid-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-site hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span class="kicker-dot" aria-hidden="true"></span>
        {settings.businessName} · {settings.city} - {settings.state}
      </p>
      <h1 id="hero-title" class="display hero-title">
        Seu próximo veículo <span class="text-gold-metal">começa aqui.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-mist-200 sm:text-xl">
        {settings.slogan}
        <span class="block text-base text-mist-400 sm:text-lg">Compra, venda, financiamento e repasses.</span>
      </p>

      <form action="/estoque" method="get" role="search" class="search-console glass" aria-label="Buscar veículos">
        <div class="search-row">
          <label for="hero-q" class="sr-only">
            Qual veículo você procura?
          </label>
          <Icon name="search" size={20} class="ml-4 shrink-0 text-gold-400" />
          <input
            id="hero-q"
            name="q"
            type="search"
            list="hero-suggestions"
            placeholder="Qual veículo você procura?"
            autocomplete="off"
            enterkeyhint="search"
            maxlength="80"
            class="h-14 w-full min-w-0 bg-transparent text-base text-white placeholder:text-mist-400 focus:outline-none"
          />
          <datalist id="hero-suggestions">
            {suggestions.map((s) => (
              <option value={s} />
            ))}
          </datalist>
          <button type="submit" class="btn btn-gold m-1.5 h-12 shrink-0 px-5 sm:px-7">
            <span class="hidden xs:inline">Buscar</span>
            <Icon name="arrow-right" size={18} class="xs:hidden" />
            <span class="sr-only xs:hidden">Buscar</span>
          </button>
        </div>
        <fieldset class="seg scrollbar-none">
          <legend class="sr-only">Categoria</legend>
          <label class="seg-item">
            <input type="radio" name="categoria" value="" checked />
            <span>Todos</span>
          </label>
          {VEHICLE_CATEGORIES.map((c) => (
            <label class="seg-item">
              <input type="radio" name="categoria" value={CATEGORY_INFO[c].slug} />
              <span>{SHORT[c]}</span>
            </label>
          ))}
        </fieldset>
      </form>

      <div class="mt-7 flex flex-col gap-3 xs:flex-row">
        <a href="/estoque" class="btn btn-outline-gold btn-lg">
          Ver estoque
          <Icon name="arrow-right" size={18} />
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
          <Icon name="whatsapp" size={20} class="text-whatsapp" />
          Falar no WhatsApp
        </a>
      </div>

      {availableCount > 0 && (
        <p class="mt-7 inline-flex items-center gap-2 text-sm text-mist-300">
          <span class="relative flex size-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success/60" />
            <span class="relative inline-flex size-2.5 rounded-full bg-success" />
          </span>
          <strong class="text-white tabular">{availableCount}</strong>
          {availableCount === 1 ? 'veículo disponível no estoque agora' : 'veículos disponíveis no estoque agora'}
        </p>
      )}
    </div>

    {spotlight && cover && (
      <a
        href={`/veiculo/${spotlight.slug}`}
        class="spot-card glass group hidden lg:flex"
        aria-label={`Em destaque: ${vehicleName(spotlight)}`}
      >
        <div class="min-w-0 flex-1">
          <p class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-gold-300">Em destaque</p>
          <p class="mt-1.5 line-clamp-2 text-2xl leading-tight font-bold text-white [font-stretch:110%]">
            {vehicleName(spotlight)}
          </p>
          {spotlightSpecs && <p class="mt-0.5 truncate text-sm text-mist-300">{spotlightSpecs}</p>}
          <PriceTag vehicle={spotlight} class="mt-4" />
        </div>
        <span class="spot-arrow spot-arrow-lg" aria-hidden="true">
          <Icon name="arrow-up-right" size={22} />
        </span>
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    --hero-min: 0px;
  }
  @media (min-width: 1024px) {
    .hero {
      --hero-min: min(46rem, calc(100svh - var(--header-h)));
    }
  }

  /* ---------- Foto do destaque ---------- */
  .hero-media {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 62svh;
    width: 100%;
    overflow: hidden;
    background: var(--color-ink-900);
  }
  @media (min-width: 640px) {
    .hero-media {
      aspect-ratio: 16 / 9;
    }
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-zoom 1.4s var(--ease-out-soft) both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
      opacity: 0.4;
    }
  }
  /* Celular: a foto funde com o fundo na parte de baixo. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-ink-950) 0%, rgb(8 9 10 / 0.55) 30%, transparent 58%),
      linear-gradient(to bottom, rgb(8 9 10 / 0.45), transparent 22%);
    pointer-events: none;
  }
  .spot-chip {
    position: absolute;
    z-index: 2;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.7rem 0.7rem 1rem;
    border-radius: 1.1rem;
  }
  .spot-chip :global(.price-main) {
    font-size: 1.05rem;
  }
  .spot-chip :global(.price-prev) {
    display: none;
  }
  .spot-chip :global(.price-por) {
    display: none;
  }
  .spot-chip-price {
    margin-left: auto;
  }
  .spot-arrow {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--gold-button);
    color: #111;
    box-shadow: var(--shadow-gold);
    transition: transform 240ms var(--ease-out-soft);
  }
  .spot-arrow-lg {
    width: 3.2rem;
    height: 3.2rem;
  }

  .hero-art {
    display: none;
  }

  .hero-veil {
    display: none;
  }

  /* ---------- Texto e busca ---------- */
  .hero-inner {
    position: relative;
    padding-bottom: 3rem;
  }
  .has-media .hero-inner {
    padding-top: 1.75rem;
  }
  .hero:not(.has-media) .hero-inner {
    padding-top: 2.75rem;
  }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink-900) 70%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-gold-500) 35%, transparent);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-300);
    backdrop-filter: blur(8px);
  }
  .kicker-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-gold-400);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-gold-500) 22%, transparent);
  }
  .hero-title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 9vw, 4.9rem);
    color: #fff;
  }

  .search-console {
    margin-top: 2rem;
    max-width: 40rem;
    padding: 0.5rem;
    border-radius: 1.5rem;
    box-shadow: 0 30px 70px -35px rgb(0 0 0 / 0.95);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }
  .search-console:focus-within {
    border-color: color-mix(in oklab, var(--color-gold-500) 70%, transparent);
    box-shadow:
      0 0 0 3px color-mix(in oklab, var(--color-gold-500) 16%, transparent),
      0 30px 70px -35px rgb(0 0 0 / 0.95);
  }
  .seg {
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0.55rem 0.15rem 0.15rem;
    border: 0;
    overflow-x: auto;
  }
  .seg-item {
    position: relative;
    flex: none;
    cursor: pointer;
  }
  .seg-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg-item span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-mist-300);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  .seg-item:hover span {
    color: #fff;
    background: color-mix(in oklab, white 7%, transparent);
  }
  .seg-item input:checked + span {
    background: color-mix(in oklab, var(--color-gold-500) 16%, transparent);
    color: var(--color-gold-200);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-gold-500) 55%, transparent);
  }
  .seg-item input:focus-visible + span {
    outline: 2px solid var(--color-gold-400);
    outline-offset: 2px;
  }
  .search-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 1.1rem;
    background: color-mix(in oklab, var(--color-ink-950) 75%, transparent);
    border: 1px solid color-mix(in oklab, white 8%, transparent);
  }

  /* ---------- Desktop: foto ocupa o lado direito, em tela cheia ---------- */
  @media (min-width: 1024px) {
    .hero {
      min-height: var(--hero-min);
      display: flex;
      align-items: center;
    }
    .hero-media {
      position: absolute;
      inset: 0 0 0 30%;
      z-index: -2;
      aspect-ratio: auto;
      max-height: none;
      width: auto;
    }
    .hero-media::after {
      background:
        linear-gradient(to right, var(--color-ink-950) 0%, rgb(8 9 10 / 0.7) 22%, transparent 55%),
        linear-gradient(to top, var(--color-ink-950) 0%, transparent 30%),
        linear-gradient(to bottom, rgb(8 9 10 / 0.5), transparent 25%);
    }
    .hero-veil {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      background: radial-gradient(60% 80% at 12% 50%, rgb(8 9 10 / 0.85), transparent 70%);
      pointer-events: none;
    }
    .hero-art {
      display: grid;
      position: absolute;
      top: 50%;
      right: 4%;
      z-index: -2;
      width: min(40vw, 38rem);
      transform: translateY(-50%);
      opacity: 0.9;
      filter: drop-shadow(0 30px 60px rgb(242 193 46 / 0.18));
    }
    .hero-inner,
    .has-media .hero-inner {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 3rem;
      margin-top: 0;
      padding-block: 4.5rem 4rem;
    }
    .hero:not(.has-media) .hero-inner {
      padding-top: 4.5rem;
    }
    .hero-copy {
      max-width: 44rem;
    }
    .spot-chip {
      display: none;
    }
    .spot-card {
      width: 24rem;
      align-items: flex-end;
      gap: 1rem;
      padding: 1.4rem 1.4rem 1.4rem 1.6rem;
      border-radius: 1.5rem;
      box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.9);
      transition:
        border-color 200ms ease,
        transform 240ms var(--ease-out-soft);
    }
    .spot-card:hover {
      border-color: color-mix(in oklab, var(--color-gold-500) 55%, transparent);
      transform: translateY(-3px);
    }
    .spot-card:hover .spot-arrow {
      transform: translate(2px, -2px);
    }
  }
</style>
