---
import Icon from '@/components/ui/Icon.astro';
import { mediaUrl, vehicleSrcset } from '@/lib/storage/keys';
import type { VehicleCard } from '@/types/domain';
import { fuelLabel, transmissionLabel, usageLabel, vehicleName, yearLabel } from '@/utils/vehicle-format';
import Badges from './Badges.astro';
import FavoriteButton from './FavoriteButton.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import PriceTag from './PriceTag.astro';

interface Props {
  vehicle: VehicleCard;
  /** Primeiros cards acima da dobra carregam sem lazy loading. */
  eager?: boolean;
  hideFeatured?: boolean;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}

const {
  vehicle: v,
  eager = false,
  hideFeatured = false,
  headingLevel: Heading = 'h3',
  sizes = '(min-width: 1536px) 400px, (min-width: 1024px) 31vw, (min-width: 640px) 47vw, 94vw',
} = Astro.props;

const href = `/veiculo/${v.slug}`;
const name = vehicleName(v);
const specs = [
  { icon: 'calendar' as const, value: yearLabel(v), label: 'Ano' },
  { icon: 'gauge' as const, value: usageLabel(v), label: 'Uso' },
  { icon: 'gear' as const, value: transmissionLabel(v.transmission), label: 'Câmbio' },
  { icon: 'fuel' as const, value: fuelLabel(v.fuel), label: 'Combustível' },
].filter((s) => s.value);
const sold = v.status === 'sold';
---

<article class:list={['vcard group', { 'is-sold': sold }]} data-vehicle-card={v.id}>
  <div class="vcard-media">
    {v.cover ? (
      <img
        src={mediaUrl(v.cover.thumbKey)}
        srcset={vehicleSrcset(v.cover)}
        sizes={sizes}
        width={v.cover.thumbWidth}
        height={v.cover.thumbHeight}
        alt={`${name} ${v.version ?? ''} ${yearLabel(v)}`.replace(/\s+/g, ' ').trim()}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="vcard-img"
      />
    ) : (
      <PhotoPlaceholder />
    )}
    <div class="vcard-shade" aria-hidden="true"></div>
    <Badges vehicle={v} hideFeatured={hideFeatured} class="absolute left-3 top-3 right-16" />
    <FavoriteButton id={v.id} name={name} class="absolute right-2.5 top-2.5" />
    {v.imageCount > 1 && (
      <span class="vcard-count" aria-label={`${v.imageCount} fotos`}>
        <Icon name="image" size={14} />
        {v.imageCount}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-mist-400">{v.brand}</p>
    <Heading class="mt-1 text-lg leading-tight font-bold text-white [font-stretch:108%]">
      <a href={href} class="vcard-link" data-astro-prefetch>
        {v.model}
      </a>
    </Heading>
    <p class="mt-0.5 truncate text-sm text-mist-300" title={v.version ?? undefined}>
      {v.version || ' '}
    </p>

    {specs.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-[0.82rem] text-mist-200">
        {specs.map((spec) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name={spec.icon} size={15} class="text-mist-500" label={spec.label} />
            <span class="tabular">{spec.value}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="min-h-4 flex-1" aria-hidden="true"></div>
    <div class="flex items-end justify-between gap-3 border-t hairline pt-4">
      <PriceTag vehicle={v} />
      <span class="vcard-arrow" aria-hidden="true">
        <Icon name="arrow-up-right" size={18} />
      </span>
    </div>
  </div>
</article>

<style>
  .vcard {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-ink-850);
    border: 1px solid color-mix(in oklab, white 7%, transparent);
    transition:
      border-color 200ms ease,
      transform 240ms var(--ease-out-soft),
      box-shadow 240ms var(--ease-out-soft);
  }
  @media (hover: hover) {
    .vcard:hover {
      border-color: color-mix(in oklab, var(--color-gold-500) 45%, transparent);
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }
    .vcard:hover .vcard-img {
      transform: scale(1.035);
    }
    .vcard:hover .vcard-arrow {
      background: var(--color-gold-500);
      color: #111;
      border-color: var(--color-gold-500);
    }
  }
  .vcard:focus-within {
    border-color: color-mix(in oklab, var(--color-gold-500) 60%, transparent);
  }
  .vcard-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-ink-800);
  }
  .vcard-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out-soft);
  }
  .vcard-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 28%, transparent 78%, rgb(0 0 0 / 0.35));
    pointer-events: none;
  }
  .is-sold .vcard-img {
    filter: grayscale(0.85) brightness(0.7);
  }
  .vcard-count {
    position: absolute;
    left: 0.75rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.45rem;
    background: rgb(8 9 10 / 0.6);
    backdrop-filter: blur(6px);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-mist-100);
  }
  /* Link "esticado": o card inteiro é clicável, sem aninhar o botão de favorito no link. */
  .vcard-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .vcard-link:focus-visible {
    outline: none;
  }
  .vcard-arrow {
    display: inline-flex;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, white 14%, transparent);
    color: var(--color-mist-200);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }
</style>
