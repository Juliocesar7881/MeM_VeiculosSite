---
import Icon from '@/components/ui/Icon.astro';
import { mediaUrl, vehicleSrcset } from '@/lib/storage/keys';
import type { VehicleCard } from '@/types/domain';
import { fuelLabel, transmissionLabel, usageLabel, vehicleName, yearLabel } from '@/utils/vehicle-format';
import Badges from './Badges.astro';
import FavoriteButton from './FavoriteButton.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import PriceTag from './PriceTag.astro';

interface Props {
  vehicle: VehicleCard;
  /** Primeiros cards acima da dobra carregam sem lazy loading. */
  eager?: boolean;
  hideFeatured?: boolean;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}

const {
  vehicle: v,
  eager = false,
  hideFeatured = false,
  headingLevel: Heading = 'h3',
  sizes = '(min-width: 1536px) 400px, (min-width: 1024px) 31vw, (min-width: 640px) 47vw, 94vw',
} = Astro.props;

const href = `/veiculo/${v.slug}`;
const name = vehicleName(v);
const specs = [
  { value: yearLabel(v), label: 'Ano' },
  { value: usageLabel(v), label: 'Uso' },
  { value: transmissionLabel(v.transmission), label: 'Câmbio' },
  { value: fuelLabel(v.fuel), label: 'Combustível' },
].filter((s) => s.value);
const sold = v.status === 'sold';
---

<article class:list={['vcard group', { 'is-sold': sold }]} data-vehicle-card={v.id}>
  <div class="vcard-media" data-vt-photo={v.cover ? undefined : href}>
    {v.cover ? (
      <img
        src={mediaUrl(v.cover.thumbKey)}
        srcset={vehicleSrcset(v.cover)}
        sizes={sizes}
        width={v.cover.thumbWidth}
        height={v.cover.thumbHeight}
        alt={`${name} ${v.version ?? ''} ${yearLabel(v)}`.replace(/\s+/g, ' ').trim()}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="vcard-img"
        data-vt-photo={href}
      />
    ) : (
      <PhotoPlaceholder />
    )}
    <div class="vcard-shade" aria-hidden="true"></div>
    <Badges vehicle={v} hideFeatured={hideFeatured} class="absolute left-3 top-3 right-16" />
    <FavoriteButton id={v.id} name={name} class="absolute right-2.5 top-2.5" />
    {v.imageCount > 1 && (
      <span class="vcard-count" aria-label={`${v.imageCount} fotos`}>
        <Icon name="image" size={14} />
        {v.imageCount}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col px-4 pb-4 pt-3.5 sm:px-5 sm:pb-5 sm:pt-4">
    <p class="text-sm font-medium text-mist-400">{v.brand}</p>
    <Heading class="title mt-0.5 text-[1.45rem] text-white">
      <a href={href} class="vcard-link" data-astro-prefetch>
        {v.model}
      </a>
    </Heading>
    <p class="mt-0.5 truncate text-sm text-mist-300" title={v.version ?? undefined}>
      {v.version || ' '}
    </p>

    {specs.length > 0 && (
      <ul class="vcard-specs mt-3.5 text-[0.84rem] text-mist-200" aria-label="Características">
        {specs.map((spec) => (
          <li>
            <span class="sr-only">{spec.label}: </span>
            <span class="tabular">{spec.value}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="min-h-4 flex-1" aria-hidden="true"></div>
    <div class="border-t hairline pt-3.5">
      <PriceTag vehicle={v} />
    </div>
  </div>
</article>

<style>
  .vcard {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-ink-850);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, white 7%, transparent);
    transition:
      box-shadow 220ms ease,
      transform 260ms var(--ease-out-soft);
  }
  @media (hover: hover) and (pointer: fine) {
    .vcard:hover {
      transform: translateY(-2px);
      box-shadow:
        inset 0 0 0 1px color-mix(in oklab, var(--color-gold-500) 40%, transparent),
        var(--shadow-lift);
    }
    .vcard:hover .vcard-img {
      transform: scale(1.035);
    }
  }
  .vcard:focus-within {
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-gold-500) 70%, transparent);
  }
  .vcard-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-ink-800);
  }
  .vcard-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out-soft);
  }
  .vcard-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 26%, transparent 80%, rgb(0 0 0 / 0.3));
    pointer-events: none;
  }
  .is-sold .vcard-img {
    filter: grayscale(0.85) brightness(0.7);
  }
  .vcard-count {
    position: absolute;
    left: 0.75rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    background: rgb(8 9 10 / 0.6);
    backdrop-filter: blur(6px);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-mist-100);
  }
  /* Especificações em linha, separadas por um traço vertical fino. */
  .vcard-specs {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.25rem;
    margin-left: calc(-2 * 0.6rem - 1px);
    clip-path: inset(0 0 0 calc(2 * 0.6rem + 1px));
  }
  .vcard-specs li {
    display: inline-flex;
    align-items: center;
  }
  /*
   * Separador antes de cada item; a lista é deslocada para a esquerda e recortada, então o
   * separador do primeiro item de cada linha fica escondido (nada de "|" no início ao quebrar).
   */
  .vcard-specs li::before {
    content: '';
    width: 1px;
    height: 0.8em;
    margin-inline: 0.6rem;
    background: color-mix(in oklab, white 18%, transparent);
  }
  /* Link "esticado": o card inteiro é clicável, sem aninhar o botão de favorito no link. */
  .vcard-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .vcard-link:focus-visible {
    outline: none;
  }
</style>
