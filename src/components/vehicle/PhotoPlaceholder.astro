---
import { LOGO_TRACO } from '@/components/brand/logo-oficial';

interface Props {
  class?: string;
  label?: string;
}

const { class: className, label = 'Fotos em breve' } = Astro.props;
---

<div class:list={['photo-placeholder', className]} role="img" aria-label={label}>
  <!-- Traço do carro da logo oficial, apagado. -->
  <img
    src={LOGO_TRACO.src}
    width={LOGO_TRACO.width}
    height={LOGO_TRACO.height}
    alt=""
    loading="lazy"
    decoding="async"
    class="placeholder-art"
  />
  <span>{label}</span>
</div>

<style>
  .photo-placeholder {
    display: flex;
    height: 100%;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: radial-gradient(120% 90% at 50% 20%, #1c1f24 0%, #0d0f11 70%);
  }
  .placeholder-art {
    width: 58%;
    max-width: 16rem;
    height: auto;
    opacity: 0.45;
  }
  .photo-placeholder span {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-mist-500);
  }
</style>
