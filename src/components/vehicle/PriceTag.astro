---
import { formatBRL } from '@/utils/money';
import { getPriceDisplay, type PriceFields } from '@/utils/offer';

interface Props {
  vehicle: PriceFields & { status: string };
  size?: 'md' | 'lg';
  class?: string;
}

const { vehicle, size = 'md', class: className } = Astro.props;
const price = getPriceDisplay(vehicle);
const sold = vehicle.status === 'sold';
---

<div class:list={['price-tag', `price-${size}`, className]}>
  {sold ? (
    <p class="price-main text-mist-400">Vendido</p>
  ) : price.current === null || price.current === 0 ? (
    <p class="price-main text-mist-100">Preço sob consulta</p>
  ) : price.previous !== null ? (
    <>
      <p class="price-prev tabular">
        <span class="sr-only">Preço anterior: </span>De <s>{formatBRL(price.previous)}</s>
        {price.discountPercent !== null && <span class="price-off">−{price.discountPercent}%</span>}
      </p>
      <p class="price-main tabular text-gold-400">
        <span class="price-por">por</span>
        <span class="sr-only">Preço atual: </span>
        {formatBRL(price.current)}
      </p>
    </>
  ) : (
    <p class="price-main tabular text-paper">{formatBRL(price.current)}</p>
  )}
</div>

<style>
  .price-main {
    font-weight: 620;
    font-stretch: 84%;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .price-md .price-main {
    font-size: 1.6rem;
  }
  .price-lg .price-main {
    font-size: clamp(2.3rem, 1.6rem + 2.4vw, 3rem);
    letter-spacing: -0.028em;
  }
  .price-prev {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
    font-size: 0.8rem;
    color: var(--color-mist-400);
  }
  .price-lg .price-prev {
    font-size: 0.95rem;
  }
  .price-prev s {
    text-decoration-thickness: 1px;
  }
  .price-off {
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: color-mix(in oklab, var(--color-gold-500) 16%, transparent);
    color: var(--color-gold-300);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .price-por {
    margin-right: 0.3rem;
    font-size: 0.5em;
    font-weight: 500;
    font-stretch: 100%;
    color: var(--color-mist-300);
    letter-spacing: 0;
  }
</style>
