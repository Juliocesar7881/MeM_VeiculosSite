---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  page: number;
  totalPages: number;
  /** Gera o link de uma página. */
  hrefFor: (page: number) => string;
}

const { page, totalPages, hrefFor } = Astro.props;

function pageList(current: number, total: number): (number | 'gap')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages = new Set([1, total, current, current - 1, current + 1]);
  if (current <= 3) [2, 3, 4].forEach((p) => pages.add(p));
  if (current >= total - 2) [total - 1, total - 2, total - 3].forEach((p) => pages.add(p));
  const sorted = [...pages].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
  const result: (number | 'gap')[] = [];
  sorted.forEach((p, i) => {
    const prev = sorted[i - 1];
    if (prev !== undefined && p - prev > 1) result.push('gap');
    result.push(p);
  });
  return result;
}

const pages = pageList(page, totalPages);
---

{totalPages > 1 && (
  <nav aria-label="Paginação" class="mt-10 flex items-center justify-center gap-1.5">
    {page > 1 ? (
      <a href={hrefFor(page - 1)} class="page-btn" rel="prev" aria-label="Página anterior">
        <Icon name="chevron-left" size={18} />
      </a>
    ) : (
      <span class="page-btn opacity-40" aria-hidden="true">
        <Icon name="chevron-left" size={18} />
      </span>
    )}
    <ul class="flex items-center gap-1.5">
      {pages.map((p) =>
        p === 'gap' ? (
          <li class="px-1 text-mist-500" aria-hidden="true">
            …
          </li>
        ) : (
          <li>
            <a
              href={hrefFor(p)}
              class:list={['page-btn tabular', { 'is-current': p === page }]}
              aria-current={p === page ? 'page' : undefined}
              aria-label={`Página ${p}`}
            >
              {p}
            </a>
          </li>
        ),
      )}
    </ul>
    {page < totalPages ? (
      <a href={hrefFor(page + 1)} class="page-btn" rel="next" aria-label="Próxima página">
        <Icon name="chevron-right" size={18} />
      </a>
    ) : (
      <span class="page-btn opacity-40" aria-hidden="true">
        <Icon name="chevron-right" size={18} />
      </span>
    )}
  </nav>
)}

<style>
  .page-btn {
    display: inline-flex;
    min-width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0 0.6rem;
    border-radius: 0.7rem;
    border: 1px solid color-mix(in oklab, white 9%, transparent);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-mist-100);
    transition:
      border-color 140ms ease,
      background-color 140ms ease;
  }
  a.page-btn:hover {
    border-color: color-mix(in oklab, var(--color-gold-500) 55%, transparent);
  }
  .page-btn.is-current {
    background: var(--color-gold-500);
    border-color: var(--color-gold-500);
    color: #111;
  }
</style>
