---
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { isActive, MAIN_NAV } from '@/config/navigation';
import { instagramUrl } from '@/lib/seo';
import type { SiteSettings } from '@/types/settings';
import { buildWhatsAppUrl, generalContactMessage } from '@/utils/whatsapp';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const pathname = Astro.url.pathname;
const whatsappUrl = buildWhatsAppUrl(settings.whatsapp, generalContactMessage(settings.businessName));
---

<header class="site-header" data-site-header>
  <div class="container-site flex h-full items-center gap-4 lg:gap-8">
    <a href="/" class="shrink-0 rounded-md" aria-label={`${settings.businessName} — página inicial`}>
      <Logo height={38} priority class="header-logo h-[34px] w-auto sm:h-[38px]" />
    </a>

    <nav aria-label="Principal" class="hidden flex-1 justify-center lg:flex">
      <ul class="flex items-center gap-1 xl:gap-2">
        {MAIN_NAV.map((item) => {
          const active = isActive(item, pathname);
          return (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2 lg:ml-0">
      {settings.instagram && (
        <a
          href={instagramUrl(settings.instagram)}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link hidden xl:inline-flex"
          aria-label="Instagram da M&M Veículos (abre em nova aba)"
        >
          <Icon name="instagram" size={20} />
        </a>
      )}
      <a href="/favoritos" class="icon-link relative" aria-label="Favoritos">
        <Icon name="heart" size={21} />
        <span class="fav-count" data-fav-count hidden></span>
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost btn-sm hidden md:inline-flex lg:hidden xl:inline-flex"
        data-track="whatsapp-header"
      >
        <Icon name="whatsapp" size={18} class="text-whatsapp" />
        <span>WhatsApp</span>
      </a>
      <a href="/anuncie-seu-veiculo" class="btn btn-gold btn-sm hidden sm:inline-flex">
        {settings.sellVehicleCta}
      </a>
      <button
        type="button"
        class="icon-link lg:hidden"
        aria-label="Abrir menu"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu" data-mobile-menu>
  <div class="flex h-full flex-col">
    <div class="flex h-[var(--header-h)] items-center justify-between px-4">
      <Logo height={34} />
      <button type="button" class="icon-link" aria-label="Fechar menu" data-menu-close>
        <Icon name="x" size={26} />
      </button>
    </div>
    <nav aria-label="Menu móvel" class="flex-1 overflow-y-auto px-4 pb-6">
      <ul class="border-t hairline">
        {MAIN_NAV.map((item) => {
          const active = isActive(item, pathname);
          return (
            <li class="border-b hairline">
              <a
                href={item.href}
                class:list={['mobile-link', { 'is-active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <Icon name="chevron-right" size={20} class="text-mist-500" />
              </a>
            </li>
          );
        })}
        <li class="border-b hairline">
          <a href="/favoritos" class="mobile-link">
            <span>Favoritos</span>
            <Icon name="heart" size={20} class="text-mist-500" />
          </a>
        </li>
      </ul>

      <div class="mt-6 grid gap-3">
        <a href="/anuncie-seu-veiculo" class="btn btn-gold btn-lg w-full">
          {settings.sellVehicleCta}
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg w-full">
          <Icon name="whatsapp" size={20} />
          Falar no WhatsApp
        </a>
      </div>

      <div class="mt-8 flex items-center gap-3 text-mist-300">
        {settings.instagram && (
          <a
            href={instagramUrl(settings.instagram)}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            aria-label="Instagram (abre em nova aba)"
          >
            <Icon name="instagram" size={22} />
          </a>
        )}
        {settings.facebook && (
          <a
            href={settings.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            aria-label="Facebook (abre em nova aba)"
          >
            <Icon name="facebook" size={22} />
          </a>
        )}
        <span class="ml-auto text-sm text-mist-400">
          {settings.city} - {settings.state}
        </span>
      </div>
    </nav>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    background: color-mix(in oklab, var(--color-ink-950) 72%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    transition:
      height 200ms var(--ease-out-soft),
      background-color 200ms ease,
      border-color 200ms ease;
  }
  :global(html[data-scrolled]) .site-header {
    height: 3.9rem;
    background: color-mix(in oklab, var(--color-ink-950) 90%, transparent);
    border-bottom-color: color-mix(in oklab, white 8%, transparent);
  }
  .header-logo {
    transition: height 200ms var(--ease-out-soft);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    border-radius: 0.6rem;
    font-size: 0.93rem;
    font-weight: 550;
    color: var(--color-mist-200);
    transition: color 140ms ease;
  }
  .nav-link:hover {
    color: #fff;
  }
  @media (min-width: 1280px) {
    .nav-link {
      padding: 0 0.85rem;
    }
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.45rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out-soft);
  }
  .nav-link:hover::after {
    transform: scaleX(0.5);
  }
  .nav-link.is-active {
    color: #fff;
  }
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .fav-count {
    position: absolute;
    top: 0.3rem;
    right: 0.25rem;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--color-gold-500);
    color: #111;
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1.1rem;
    text-align: center;
  }
  .fav-count[hidden] {
    display: none;
  }
  .mobile-menu {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-ink-950);
    color: var(--color-paper);
  }
  .mobile-menu::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .mobile-menu[open] {
    animation: menu-in 220ms var(--ease-out-soft);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.6rem;
    font-size: 1.3rem;
    font-weight: 650;
    font-stretch: 110%;
    letter-spacing: -0.01em;
  }
  .mobile-link.is-active {
    color: var(--color-gold-400);
  }
</style>

<script>
  import { initHeader } from '@/features/header';
  initHeader();
</script>
