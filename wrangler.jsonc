// Cloudflare Workers — M&M Veículos
// Build: npm run cf:build   ·   Deploy: npm run cf:deploy   ·   docs/DEPLOY.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mm-veiculos",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Smart Placement: executa o Worker perto do D1 quando isso reduz a latência das consultas.
  "placement": { "mode": "smart" },

  // Banco de dados (SQLite). Migrations: npm run cf:migrate
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mm-veiculos",
      "database_id": "693142c6-a23b-479d-83a5-40cf00ff3275",
      "migrations_dir": "migrations",
    },
  ],

  // Fotos no R2 (bucket privado; 10 GB grátis, teto de 9 GB no painel). O KV antigo continua ligado
  // só como reserva de leitura durante a migração (lib/storage/fallback.ts): o que ainda não estiver no
  // R2 é lido de lá. Depois de conferir (npm run cf:migrate-media -- --check), remova "kv_namespaces".
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mm-veiculos-media" }],
  "kv_namespaces": [{ "binding": "MEDIA_KV", "id": "07d500e6534c4d558dca80ef113621cb" }],

  // Variáveis públicas (não secretas). Segredos: `npx wrangler secret put <NOME>`
  // (ADMIN_PASSWORD_HASH, SESSION_SECRET, IP_HASH_SALT, TURNSTILE_SECRET_KEY)
  "vars": {
    "STORAGE_DRIVER": "r2",
    "AUTH_MODE": "password",
    "ALLOW_INDEXING": "false",
    // Chave pública do widget Turnstile (hostname: mm-veiculos.lupinho7881.workers.dev). Adicione o
    // domínio definitivo no painel do Turnstile quando ele existir.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFCiSR2Su9bfoT-b",
  },
}
